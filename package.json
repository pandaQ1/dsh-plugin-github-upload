{
  "name": "dsh-plugin-github-upload",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "title": "GitHub 门房",
  "description": "新机器上的第一块砖：设备码登录 GitHub（或粘 PAT），然后把 DSH 插件同步到私有库、或从私有库装回来。一个插件一个库，增量上传、首次自动建库。",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./gate": "./gate.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "icon": "./icon.svg",
  "files": [
    "index.js",
    "client.js",
    "gate.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "assets/**",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "github",
    "oauth-device-flow",
    "backup",
    "restore"
  ],
  "license": "MIT"
}
